{
  "name": "bioma",
  "version": "0.1.0",
  "private": true,
  "description": "PROM — трекер аналізів з AI-розпізнаванням фото. Монорепо: client (React) + server (NestJS).",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "db:studio": "pnpm --filter server db:studio",
    "lint": "pnpm -r lint"
  }
}
