VITE_API_URL=http://localhost:3001

# У dev — same-origin шлях через Vite-проксі (див. NEON_AUTH_PROXY_TARGET):
# сесійна cookie Neon Auth стає first-party, і браузер її не ріже.
VITE_NEON_AUTH_URL=http://localhost:5173/neondb/auth

# Реальний хост Neon Auth для dev-проксі (Neon Console → ваш проєкт → Auth).
# Той самий хост, що й у NEON_AUTH_JWKS_URL на бекенді.
NEON_AUTH_PROXY_TARGET=https://ep-xxx.neonauth.<region>.aws.neon.tech
