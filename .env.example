# ────────────────────────────────────────────────────────────
#  Root .env.example — скопіюйте у client/.env та server/.env
#  (значення нижче — приклад; заповніть своїми)
# ────────────────────────────────────────────────────────────

# --- Neon Postgres (той самий рядок для Prisma) ---
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Neon Auth (Stack Auth) ---
# Дашборд Neon → Auth → Configuration
NEON_AUTH_PROJECT_ID="your-stack-project-id"
NEON_AUTH_JWKS_URL="https://api.stack-auth.com/api/v1/projects/your-stack-project-id/.well-known/jwks.json"

# для фронту (Vite вимагає префікс VITE_)
VITE_STACK_PROJECT_ID="your-stack-project-id"
VITE_STACK_PUBLISHABLE_CLIENT_KEY="pck_..."
VITE_API_URL="http://localhost:3001"

# --- Anthropic (AI-розпізнавання фото аналізів) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Server ---
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"

# --- Демо-режим (необов'язково; див. docs/DEVELOPMENT.md) ---
# DEMO_MODE=true              # server: вхід за демо-логіном замість Neon Auth
# DEMO_EMAIL=demo@bioma.app
# DEMO_PASSWORD=demo1234
# DEMO_JWT_SECRET=            # порожньо — випадковий ключ на кожен старт
# SEED_DEMO_EXTRAS=true       # сід: тілесні метрики, самопочуття, добавки
# VITE_DEMO_MODE=true         # client
