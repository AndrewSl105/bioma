DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon Auth (Better Auth). Neon Console → ваш проєкт → Auth.
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json"
# Провайдер для розпізнавання бланків: "anthropic" (за замовчуванням) або "openai"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY="sk-proj-..."
# gpt-5.6-terra потребує доступу до моделі на вашому плані; при 404/403 поставте gpt-4o
OPENAI_MODEL="gpt-5.6-terra"
# Демо-дані пацієнта в сіді: id вашого користувача з Neon Auth (sub). Обов'язковий —
# без нього сід завершиться помилкою після заливки каталогу.
SEED_USER_ID=""
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"

# Локальна розробка без реального логіну: guard пропускає JWKS-перевірку
# і кладе фіксованого dev-користувача. Пара до VITE_AUTH_DEV_BYPASS на клієнті.
# НЕ вмикати у проді.
# AUTH_DEV_BYPASS=true
