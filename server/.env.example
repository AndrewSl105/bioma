DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
NEON_AUTH_JWKS_URL="https://api.stack-auth.com/api/v1/projects/YOUR_PROJECT_ID/.well-known/jwks.json"
NEON_AUTH_PROJECT_ID="YOUR_PROJECT_ID"
# Провайдер для розпізнавання бланків: "anthropic" (за замовчуванням) або "openai"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"
OPENAI_API_KEY="sk-proj-..."
# gpt-5.6-terra потребує доступу до моделі на вашому плані; при 404/403 поставте gpt-4o
OPENAI_MODEL="gpt-5.6-terra"
PORT=3001
CLIENT_ORIGIN="http://localhost:5173"
