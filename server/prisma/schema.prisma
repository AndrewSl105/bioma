// ─────────────────────────────────────────────────────────────
//  Bioma — Prisma schema (Neon Postgres)
// ─────────────────────────────────────────────────────────────
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
  ANY
}

enum ResultSource {
  MANUAL // введено вручну
  AI_PHOTO // розпізнано з фото документа
  IMPORT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ResultFlag {
  LOW
  NORMAL
  HIGH
  UNKNOWN
}

/// Спосіб життя — контекст до трактування показників (перегукується з
/// influencingFactors у контенті). Свідомо грубі категорії, а не цифри:
/// «скільки саме ви п'єте» ми не питаємо і не рахуємо.
enum SmokingStatus {
  NEVER
  FORMER
  CURRENT
}

enum AlcoholUse {
  NONE
  OCCASIONAL
  REGULAR
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  HIGH
}

/// Фаза циклу. Обчислюється з історії відміток, у БД не зберігається —
/// інакше вона розходилася б із даними при кожній правці дня менструації.
enum CyclePhase {
  MENSTRUAL
  FOLLICULAR
  OVULATION
  LUTEAL
}

enum FlowLevel {
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
}

/// Що саме приймає людина. Ліки й добавки розділені, бо це різні за характером
/// речі: добавку людина обирає сама, ліки зазвичай призначені — і формулювання
/// в інтерфейсі мають це враховувати.
enum IntakeType {
  MEDICATION
  SUPPLEMENT
}

/// Тілесна метрика. Окрема модель, а не запис у каталозі біомаркерів:
/// це не лабораторний аналіз, у неї немає бланка, лабораторії й панелі,
/// а вводить її людина сама і значно частіше.
///
/// Зріст сюди свідомо НЕ входить — він майже сталий у дорослого і живе на
/// UserProfile.heightCm. ІМТ теж не входить: він похідний (вага + зріст) і
/// обчислюється на читанні, щоб не було двох джерел правди.
enum BodyMetricKind {
  WEIGHT
  WAIST
  RESTING_HR
  BP_SYSTOLIC
  BP_DIASTOLIC
}

/// Наші поля користувача. САМА особа (email, ім'я) живе ТІЛЬКИ в Neon Auth
/// (neon_auth.users_sync) — тут ми її не дублюємо.
/// userId === Neon Auth id (sub з JWT). Свідомо БЕЗ FK на neon_auth.users_sync:
/// це керована Neon схема, і зовнішній ключ у неї нам не належить.
/// Рядок створюється явно при першому вході — POST /api/profile/ensure.
model UserProfile {
  userId    String    @id
  sex       Sex?
  birthDate DateTime?

  /// Мова інтерфейсу. Не enum: додати локаль має бути правкою словників, а не
  /// міграцією БД. Дефолт український — це мова застосунку за замовчуванням.
  locale String @default("uk")

  /// Спосіб життя. Усе опційне: це контекст, а не анкета, яку треба пройти,
  /// щоб користуватися застосунком.
  smokingStatus SmokingStatus?
  alcoholUse    AlcoholUse?
  activityLevel ActivityLevel?

  /// Зріст у сантиметрах. На профілі, а не часовим рядом: у дорослого він
  /// практично не змінюється, а потрібен постійно — для розрахунку ІМТ.
  heightCm Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bodyMetrics   BodyMetric[]
  intakes       UserIntake[]
  wellbeing     WellbeingLog[]
  cycleDays     MenstrualDay[]
  cycleSettings CycleSettings?
  results       LabResult[]
  panels        LabPanel[]
  documents     Document[]
  promResponses PromResponse[]
  biomarkers    Biomarker[] // історичні custom-біомаркери (нові не створюються)
  selected      UserBiomarker[] // показники, обрані на дашборд
}

/// Категорія біомаркерів. Керується адміністратором в адмінці.
/// Картинка лежить у Cloudflare R2; у БД зберігаємо лише ключ об'єкта,
/// а публічний URL збирається з R2_PUBLIC_BASE_URL — щоб зміна домену
/// чи бакета не вимагала переписувати рядки в базі.
model BiomarkerCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  imageKey  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  biomarkers   Biomarker[]
  translations BiomarkerCategoryTranslation[]
}

/// Локалізована назва категорії. BiomarkerCategory.name лишається каноном і
/// відкатом: категорія без перекладу показується саме ним, а не порожнім рядком.
model BiomarkerCategoryTranslation {
  id         String            @id @default(cuid())
  categoryId String
  category   BiomarkerCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  locale String
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, locale])
  @@index([categoryId])
}

/// Тип аналізу / показник (напр. "Вітамін D (25-OH)", "Загальний холестерин").
///
/// Каталог належить системі: маркери заводить адміністратор, а користувач їх
/// лише ОБИРАЄ собі на дашборд (див. UserBiomarker). Створювати власні
/// показники користувач більше не може.
///
/// ownerId лишається nullable заради історичних custom-маркерів, заведених до
/// цієї зміни; для всього нового ownerId = null.
model Biomarker {
  id      String  @id @default(cuid())
  ownerId String?
  owner   UserProfile? @relation(fields: [ownerId], references: [userId], onDelete: Cascade)

  /// Системний показник із загального каталогу — той, що видно всім у списку.
  isSystem Boolean @default(false)

  /// Хто завів показник: 'admin' для сіду, інакше userId адміністратора.
  /// Не FK: адміна могли видалити, а маркер має пережити його.
  createdBy String?

  slug String // напр. "vitamin-d", унікальний у межах власника

  /// Канон — англійською. Локалізовані назви живуть у BiomarkerTranslation.
  canonicalName  String // "Vitamin D (25-OH)"
  canonicalShort String? // "Vitamin D"

  unit String // "нг/мл", "ммоль/л", "МО/мл"

  /// Nullable свідомо: власні біомаркери користувача категорії не мають,
  /// і робити її обов'язковою означало б зламати createCustom.
  categoryId String?
  category   BiomarkerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Стара довільна рядкова категорія. Лишається ЛИШЕ як джерело для
  /// backfill і прибирається окремою міграцією, коли код перестане її
  /// читати. Не використовувати в новому коді.
  legacyCategory String? @map("category")

  isActive    Boolean @default(true)

  /// Типовий інтервал перездачі в днях — орієнтир від адміністратора.
  /// Особистий інтервал користувача (UserBiomarker.retestIntervalDays) його
  /// перекриває: періодичність залежить від людини, а не від показника.
  defaultRetestDays Int?

  loincCode   String? // код LOINC (для мапінгу з AI), опційно
  description String?
  precision   Int     @default(2) // к-сть знаків після коми

  /// Градації інтерпретації (пороги + label) для зон на графіку. Формат — catalog.ts:Band[].
  bands Json?

  referenceRanges ReferenceRange[]
  translations    BiomarkerTranslation[]
  results         LabResult[]
  selectedBy      UserBiomarker[]
  content         BiomarkerContent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, slug])
  @@index([slug])
  @@index([categoryId])
  @@index([isSystem])
}

/// Показник, який користувач обрав відстежувати — саме це наповнює дашборд.
/// Картка з'являється одразу після вибору, ще до першого результату, тож у
/// нового користувача дашборд порожній, поки він не додасть щось зі списку.
///
/// Рядок з'являється двома шляхами: явним вибором зі списку і автоматично при
/// записі результату (ручному чи з фото) — інакше внесене значення не потрапило
/// б на дашборд.
model UserBiomarker {
  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  biomarkerId String
  biomarker   Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)

  /// Особистий інтервал перездачі. null — беремо Biomarker.defaultRetestDays;
  /// якщо й там порожньо, нагадування для цього показника просто немає.
  retestIntervalDays Int?

  createdAt DateTime @default(now())

  @@id([userId, biomarkerId])
  @@index([userId])
  @@index([biomarkerId])
}

/// Довідковий контент про біомаркер — окремий запис на кожну мову.
///
/// Окрема модель, а не JSON на Biomarker: поля валідуються DTO, а локалізація
/// працює тим самим механізмом, що й назви. Усі поля nullable — контент
/// наповнюється поступово, і напівзаповнений запис має лишатися валідним.
///
/// ВАЖЛИВО: це освітня інформація, НЕ медична порада. Формулювання описові
/// («може бути пов'язано з…»), без наказового способу щодо ліків і доз;
/// клієнт показує контент лише разом із дисклеймером.
model BiomarkerContent {
  id          String    @id @default(cuid())
  biomarkerId String
  biomarker   Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)

  locale String

  overview       String? // що це за показник
  whatItMeasures String? // що саме вимірює
  roleInBody     String? // роль в організмі

  /// Проза, а не список: автор описує зв'язки реченням («Імунна й ендокринна
  /// системи; щитоподібна залоза»), і дробити це на пункти означало б
  /// вигадувати за нього структуру, якої в тексті немає.
  /// Лишається підписом під чипами — для нюансів, яких ключ не передає.
  relatedSystems  String? // системи організму
  functionalLinks String? // зв'язок з енергією, сном, витривалістю тощо

  /// Мовно-незалежні ключі таксономії — саме за ними клієнт малює чипи з
  /// іконками. Окремо від прози свідомо: розбирати текст регулярками означало б
  /// ставити іконку в залежність від формулювання, і переклад ламав би вигляд.
  /// Дублюються по локалях (модель per-locale) — ціна за те, що редагуються
  /// в тій самій формі, що й решта контенту.
  relatedSystemKeys String[]
  functionalTagKeys String[]

  lowMeaning  String? // що може означати низьке значення
  highMeaning String? // що може означати високе значення

  /// Класи препаратів, від яких показник може залежати — мовно-незалежні
  /// ключі (DRUG_CLASS_KEYS). Саме за ними прив'язується прийом користувача:
  /// шукати клас у прозі drugClassesInfo означало б ставити прив'язку в
  /// залежність від формулювання, і переклад її ламав би.
  affectedByDrugClasses String[]

  influencingFactors String? // фактори впливу на результат
  preparation        String? // підготовка до здавання

  /// Slug'и наявних біомаркерів — щоб клієнт рендерив клікабельні посилання.
  /// Нативний масив Postgres, а не Json: тут завжди перелік рядків, і типізація
  /// на рівні БД позбавляє клієнт перевірок «а раптом це не масив».
  /// Не relation свідомо: міграція на неї лишається можливою.
  commonlyEvaluatedWith String[]
  confirmatoryTests     String[]

  foodSources     String? // харчові джерела
  supplementsInfo String? // загальна інформація про добавки
  drugClassesInfo String? // класи препаратів, що можуть впливати

  /// [{ title, url }] — медичні джерела.
  medicalSources Json?

  lastReviewedAt DateTime?
  reviewedBy     String? // userId або ім'я того, хто перевіряв

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([biomarkerId, locale])
  @@index([biomarkerId])
}

/// Референсні межі. Можуть залежати від статі/віку.
/// optimal* — «оптимальний» діапазон (вужчий за лабораторну норму), опційно.
/// Локалізовані назви біомаркера. Канон (англ.) лишається на Biomarker.
model BiomarkerTranslation {
  id          String    @id @default(cuid())
  biomarkerId String
  biomarker   Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)

  locale    String // "uk", "en", …
  name      String // "Вітамін D (25-OH)"
  shortName String? // "Вітамін D"
  category  String? // "Вітаміни"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([biomarkerId, locale])
  @@index([biomarkerId])
}

model ReferenceRange {
  id          String    @id @default(cuid())
  biomarkerId String
  biomarker   Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)

  low         Float?
  high        Float?
  optimalLow  Float?
  optimalHigh Float?
  unit        String
  sex         Sex     @default(ANY)
  ageMinYears Int?
  ageMaxYears Int?
  source      String? // "Виробник тесту", "Endocrine Society" тощо

  createdAt DateTime @default(now())

  @@index([biomarkerId])
}

/// Панель/комплекс — група результатів з одного документа/дати
/// (напр. "Комплекс №112 Ліпідограма").
model LabPanel {
  id         String      @id @default(cuid())
  userId     String
  user       UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  name       String?
  labName    String? // назва лабораторії
  takenAt    DateTime // дата забору/дослідження
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  results   LabResult[]
  createdAt DateTime    @default(now())

  @@index([userId, takenAt])
}

/// Одне виміряне значення.
model LabResult {
  id          String      @id @default(cuid())
  userId      String
  user        UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  biomarkerId String
  biomarker   Biomarker   @relation(fields: [biomarkerId], references: [id], onDelete: Restrict)

  /// Значення В КАНОНІЧНІЙ одиниці показника — саме його рахують прапорець,
  /// референси й тренд. Якщо бланк був в іншій одиниці, тут уже перерахунок.
  value      Float
  unit       String

  /// Оригінал бланка: що саме ввела людина і в чому. Заповнюється завжди,
  /// навіть коли конверсії не було, — інакше «як у бланку» довелося б
  /// відновлювати зворотним рахунком, а це втрата точності й довіри.
  enteredValue Float?
  enteredUnit  String?

  measuredAt DateTime // дата аналізу (не дата вводу)
  flag       ResultFlag   @default(UNKNOWN)
  source     ResultSource @default(MANUAL)
  note       String?
  rawText    String? // сирий текст рядка з документа (для AI)
  confidence Float? // впевненість AI [0..1], лише для AI_PHOTO

  panelId String?
  panel   LabPanel? @relation(fields: [panelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, biomarkerId, measuredAt])
}

/// Ліки й добавки, які приймає користувач.
///
/// ЧУТЛИВІ персональні дані: доступ лише власнику, нікуди не показуємо
/// публічно і в адмінці не редагуємо — адміністратор веде каталог, а не
/// призначення конкретної людини.
///
/// Ми НЕ інтерпретуємо дози й нічого не радимо: dosageText — вільний текст,
/// який ми лише зберігаємо і показуємо назад. Єдине, що робить застосунок —
/// освітньо зазначає, що показник може залежати від класу препарату.
model UserIntake {
  id     String      @id @default(cuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  type IntakeType
  /// Вільний текст мовою користувача — назва на упаковці, а не з довідника.
  name String

  /// Ключ класу з таксономії (DRUG_CLASS_KEYS). Опційний: людина може
  /// записати щось, чого в таксономії немає, і це не привід не дати їй
  /// зберегти запис — просто не буде автоматичної прив'язки до показників.
  drugClassKey String?

  dosageText String?
  startDate  DateTime?
  /// null означає «приймає зараз» — саме за цим визначається активність.
  endDate    DateTime?
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// День циклу.
///
/// НАЙЧУТЛИВІШІ дані застосунку: лише власник, за явною згодою (CycleSettings
/// .enabled), і видаляються окремою дією, не чекаючи видалення акаунта.
///
/// Один запис на дату (@db.Date): позначити день двічі означає виправити
/// відмітку, а не завести другу.
model MenstrualDay {
  id     String      @id @default(cuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  date     DateTime  @db.Date
  isPeriod Boolean   @default(false)
  flow     FlowLevel?
  /// Ключі симптомів (cramps, headache…) — мовно-незалежні, підписи на клієнті.
  symptoms String[]
  mood     Int?
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Налаштування трекінгу циклу.
///
/// enabled — саме згода: доки вона не дана, розділ не показується і дані не
/// збираються. Середні довжини НЕ хардкодяться на 28/5, а рахуються з
/// історії; поля тут — лише збережений кеш/ручне уточнення.
model CycleSettings {
  userId String      @id
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  enabled         Boolean @default(false)
  avgCycleLength  Int?
  avgPeriodLength Int?
  /// awareness | conception | avoidance — суто інформативно, на логіку не впливає.
  trackingGoal    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Щоденний чек-ін самопочуття.
///
/// Один запис на день: @db.Date, а не DateTime — без цього два чек-іни за
/// один день з різним часом були б різними рядками, і @@unique нічого б не
/// стримував. Правка сьогоднішнього запису має ПЕРЕЗАПИСУВАТИ, а не додавати.
///
/// Шкали 1..5 і всі опційні: людина може відзначити лише сон і піти. Настрій
/// — чутлива тема, тож тон нейтральний; ніяких клінічних висновків і жодної
/// кризової логіки тут свідомо немає (для валідованих шкал є PROM).
model WellbeingLog {
  id     String      @id @default(cuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  date DateTime @db.Date

  energy       Int?
  sleepQuality Int?
  sleepHours   Float?
  mood         Int?
  digestion    Int?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

/// Одне виміряне значення тілесної метрики.
///
/// Тиск зберігається ДВОМА рядками (BP_SYSTOLIC + BP_DIASTOLIC) зі спільним
/// measuredAt, а не одним рядком із двома полями: так кожна метрика лишається
/// одним числом із власною історією та зонами, а «120/80» збирається на
/// читанні. Одне поле під тиск означало б окрему гілку в кожному запиті.
model BodyMetric {
  id     String      @id @default(cuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  kind       BodyMetricKind
  value      Float
  measuredAt DateTime
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind, measuredAt])
}

/// Завантажене фото/скан документа аналізів.
model Document {
  id         String         @id @default(cuid())
  userId     String
  user       UserProfile    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  storageKey String // ключ/URL у сховищі (S3 / Neon blob / локально)
  mimeType   String
  fileName   String?
  status     DocumentStatus @default(PENDING)
  aiRaw      Json? // повна відповідь AI-екстракції
  error      String?

  panels    LabPanel[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
}

// ── PROM (Patient-Reported Outcome Measures) ──────────────────
/// Опитувальник (напр. PHQ-9, шкала самопочуття).
model PromInstrument {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  /// JSON-опис питань та схеми підрахунку балів.
  schema      Json

  responses PromResponse[]
  createdAt DateTime       @default(now())
}

/// Проходження опитувальника користувачем.
model PromResponse {
  id           String         @id @default(cuid())
  userId       String
  user         UserProfile    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  instrumentId String
  instrument   PromInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  answers Json // { questionId: value }
  score   Float? // обчислений сумарний бал
  takenAt DateTime @default(now())

  @@index([userId, instrumentId, takenAt])
}
