// ─────────────────────────────────────────────────────────────
//  PROM — Prisma schema (Neon Postgres)
// ─────────────────────────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
  ANY
}

enum ResultSource {
  MANUAL      // введено вручну
  AI_PHOTO    // розпізнано з фото документа
  IMPORT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ResultFlag {
  LOW
  NORMAL
  HIGH
  UNKNOWN
}

/// Дзеркало користувача з Neon Auth (Stack Auth).
/// id === Stack user id (sub з JWT). Створюється при першому запиті.
model User {
  id        String   @id
  email     String?
  name      String?
  sex       Sex?
  birthDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results       LabResult[]
  panels        LabPanel[]
  documents     Document[]
  biomarkers    Biomarker[]   // користувацькі (custom) біомаркери
  promResponses PromResponse[]
}

/// Тип аналізу / показник (напр. "Вітамін D (25-OH)", "Загальний холестерин").
/// ownerId = null → глобальний каталог; інакше — власний біомаркер користувача.
model Biomarker {
  id          String   @id @default(cuid())
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  slug        String   // напр. "vitamin-d", унікальний у межах власника
  name        String   // "Вітамін D (25-OH)"
  shortName   String?  // "Вітамін D"
  unit        String   // "нг/мл", "ммоль/л", "МО/мл"
  category    String?  // "Вітаміни", "Ліпідограма", "Гормони"
  loincCode   String?  // код LOINC (для мапінгу з AI), опційно
  description String?
  precision   Int      @default(2) // к-сть знаків після коми

  referenceRanges ReferenceRange[]
  results         LabResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, slug])
  @@index([slug])
}

/// Референсні межі. Можуть залежати від статі/віку.
/// optimal* — «оптимальний» діапазон (вужчий за лабораторну норму), опційно.
model ReferenceRange {
  id          String  @id @default(cuid())
  biomarkerId String
  biomarker   Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Cascade)

  low        Float?
  high       Float?
  optimalLow Float?
  optimalHigh Float?
  unit       String
  sex        Sex     @default(ANY)
  ageMinYears Int?
  ageMaxYears Int?
  source     String? // "Виробник тесту", "Endocrine Society" тощо

  createdAt DateTime @default(now())

  @@index([biomarkerId])
}

/// Панель/комплекс — група результатів з одного документа/дати
/// (напр. "Комплекс №112 Ліпідограма").
model LabPanel {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String?
  labName     String?  // назва лабораторії
  takenAt     DateTime // дата забору/дослідження
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  results   LabResult[]
  createdAt DateTime @default(now())

  @@index([userId, takenAt])
}

/// Одне виміряне значення.
model LabResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  biomarkerId String
  biomarker   Biomarker @relation(fields: [biomarkerId], references: [id], onDelete: Restrict)

  value       Float
  unit        String
  measuredAt  DateTime          // дата аналізу (не дата вводу)
  flag        ResultFlag  @default(UNKNOWN)
  source      ResultSource @default(MANUAL)
  note        String?
  rawText     String?           // сирий текст рядка з документа (для AI)
  confidence  Float?            // впевненість AI [0..1], лише для AI_PHOTO

  panelId     String?
  panel       LabPanel? @relation(fields: [panelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, biomarkerId, measuredAt])
}

/// Завантажене фото/скан документа аналізів.
model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey  String   // ключ/URL у сховищі (S3 / Neon blob / локально)
  mimeType    String
  fileName    String?
  status      DocumentStatus @default(PENDING)
  aiRaw       Json?    // повна відповідь AI-екстракції
  error       String?

  panels    LabPanel[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// ── PROM (Patient-Reported Outcome Measures) ──────────────────
/// Опитувальник (напр. PHQ-9, шкала самопочуття).
model PromInstrument {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String?
  /// JSON-опис питань та схеми підрахунку балів.
  schema      Json

  responses PromResponse[]
  createdAt DateTime @default(now())
}

/// Проходження опитувальника користувачем.
model PromResponse {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId String
  instrument   PromInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  answers   Json     // { questionId: value }
  score     Float?   // обчислений сумарний бал
  takenAt   DateTime @default(now())

  @@index([userId, instrumentId, takenAt])
}
